VITE_SANITY_PROJECT_ID=xqdkz7sb
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2026-06-02

# Canonical base URL used for canonical tags, OG/Twitter URLs, and sitemap.xml
VITE_SITE_URL=https://yourcreditpal.com

# 'checkbox' (default) requires an explicit checked box on the apply form's final consent.
# 'implied' treats clicking Submit My Application as consent, no checkbox shown.
VITE_CONSENT_MODE=checkbox

# Google Tag Manager container ID (GTM-XXXXXXX). Leave unset to disable the GTM bootstrap.
VITE_GTM_CONTAINER_ID=
